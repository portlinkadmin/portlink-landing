# portlink-landing — public marketing site. No Supabase backend.
#
# Secret-free template. Real values live in 1Password (vault: PortLink) and are
# injected at runtime — never written to disk:
#
#   op run --env-file=.env.op -- npm run dev
#
# Email (Resend) — contact / waitlist form delivery.
RESEND_API_KEY=op://PortLink/Resend — PortLink — API key/credential

# Non-secret site config (set the real address if the form needs it):
# ADMIN_EMAIL=david@portlink.app
